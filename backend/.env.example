# ---------- Database (MySQL) ----------
DATABASE_URL=mysql+pymysql://homecare:homecare_pass@localhost:3306/homecare_db

# ---------- Security ----------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_RESET_EXPIRE_MINUTES=30
ENVIRONMENT=development
# Dev only: when SMTP is not configured, show the reset link in the UI instead of emailing it.
EXPOSE_RESET_TOKEN_IN_DEV=true

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
MAX_UPLOAD_MB=5

# ---------- AI HomeCare Assistant (optional) ----------
# Leave LLM_API_KEY empty to use the built-in rule-based assistant.
# LLM_PROVIDER: "anthropic" or "openai" (any OpenAI-compatible endpoint, e.g. Groq/OpenRouter via LLM_BASE_URL)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# ---------- Email notifications (optional) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=homecare@example.com
SMTP_USE_TLS=true
